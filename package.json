    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.1",
    "puppeteer-core": "^25.5.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
